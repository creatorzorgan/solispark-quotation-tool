# --- Client (Vite; safe to expose in bundle) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: same value as server EQUIPMENT_UPLOAD_API_KEY when using upload protection
VITE_EQUIPMENT_UPLOAD_API_KEY=

# Optional: defaults to equipment-datasheets
# VITE_EQUIPMENT_STORAGE_BUCKET=equipment-datasheets

# Optional: when using `npm run dev` but calling deployed Vercel APIs
# VITE_API_ORIGIN=https://your-app.vercel.app

# Optional: proxy /api to `vercel dev` while running Vite (e.g. http://localhost:3000)
# VITE_VERCEL_DEV_API=http://localhost:3000

# --- Vercel serverless only (never VITE_*) ---
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# EQUIPMENT_STORAGE_BUCKET=equipment-datasheets
# EQUIPMENT_UPLOAD_API_KEY=
